{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**/*", "!{projectRoot}/data/**/*"],
    "production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.test.mjs"]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "{workspaceRoot}/package-lock.json"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/package-lock.json"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/package-lock.json"]
    },
    "code-lint": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/.eslintrc.cjs", "{workspaceRoot}/package-lock.json"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/package-lock.json"]
    },
    "dev": {
      "continuous": true
    },
    "start": {
      "continuous": true
    },
    "storybook": {
      "continuous": true
    },
    "storybook:build": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/package-lock.json"],
      "outputs": ["{projectRoot}/dist/storybook"]
    }
  }
}
