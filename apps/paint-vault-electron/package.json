{
  "name": "paint-vault-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Paint Vault desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test *.test.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.paintvault.desktop",
    "productName": "Paint Vault",
    "asar": true,
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "main.cjs",
      "desktop-core.cjs",
      "desktop-startup.cjs",
      "desktop-update.cjs",
      "preload.cjs",
      "package.json",
      "desktop-i18n.cjs",
      "desktop-preferences.cjs",
      "desktop-menu.cjs",
      "desktop-support.cjs"
    ],
    "extraResources": [
      {
        "from": "../paint-vault-web/dist",
        "to": "web-dist"
      },
      {
        "from": "desktop-server",
        "to": "server"
      },
      {
        "from": "desktop-server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../../packages/paint-i18n/locales",
        "to": "locales"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moonryc",
        "repo": "paint-tracker",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "fflate": "^0.8.3",
    "i18next": "^27.1.1"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
